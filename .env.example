# CertifyAI — Example environment variables
# Copy to `.env` and fill in your own values. NEVER commit `.env`.
#   cp .env.example .env

# LLM API key for live verification runs (NVIDIA NIM in this example).
# Get one at https://build.nvidia.com — free tier works for dry runs.
CERTIFYAI_API_KEY=your-api-key-here

# Provider plugin id (see certifyai/engine/ for supported providers).
CERTIFYAI_PROVIDER=nvidia_nim

# Default model for live runs.
CERTIFYAI_MODEL=meta/llama-3.1-8b-instruct
